# Loopback listener
PORT=8090
HOST=127.0.0.1

# Where the browser profile, sessions, cache and the generated API key live
DATA_DIR=./data

# Client API key. Leave empty to have one generated into DATA_DIR/api-key.txt on first start.
API_KEY=

# Browser
MUSE_URL=https://muse.ai/
HEADLESS=true
# Use an installed Google Chrome instead of Playwright's Chromium: chrome | msedge | (empty)
BROWSER_CHANNEL=

# Turn limits
MAX_CONCURRENT_TURNS=2
# Pre-create side chats while idle; set to 0 to disable (use one extra turn slot when enabled)
WARM_THREADS=1
QUEUE_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=900
STALL_TIMEOUT_SEC=180

# Reuse the same Muse conversation for follow-up requests (seconds)
SESSION_TTL_SEC=86400
# Exact-match response cache (seconds, 0 disables)
CACHE_TTL_SEC=300

LOG_LEVEL=info
