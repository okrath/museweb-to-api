{
  "name": "museweb-to-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local gateway that exposes a signed-in muse.ai web session as OpenAI- and Anthropic-compatible HTTP APIs.",
  "bin": {
    "museweb-to-api": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js serve",
    "muse:login": "tsx src/index.ts login",
    "muse:clean": "tsx src/index.ts clean-threads",
    "muse:probe": "tsx src/index.ts probe",
    "build": "rimraf dist && tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "browser:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "nanoid": "^5.1.5",
    "pino": "^9.9.5",
    "pino-pretty": "^13.1.1",
    "playwright": "^1.58.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/turndown": "^5.0.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
